/dts-v1/;

#include <dt-bindings/arm/qcom,ids.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include "kaanapali.dtsi"

#include "pm8010-kaanapali.dtsi"     /* SPMI1: SID-12/13   */
#include "pmd8028-kaanapali.dtsi"    /* SPMI1: SID-4       */
#include "pmh0101.dtsi"              /* SPMI0: SID-1       */
#include "pmh0104-kaanapali.dtsi"    /* SPMI1: SID-9       */
#include "pmh0110-kaanapali.dtsi"    /* SPMI0: SID-3/5/6/8 */
#include "pmih0108-kaanapali.dtsi"   /* SPMI1: SID-7       */
#include "pmk8850.dtsi"              /* SPMI0: SID-0       */
#include "pmr735d-kaanapali.dtsi"    /* SPMI1: SID-10      */

/delete-node/ &rmtfs_mem;

/ {
	model = "OnePlus 15";
	compatible = "oneplus,infiniti", "qcom,kaanapali";
	chassis-type = "handset";

	/* required for bootloader to select correct board */
	qcom,msm-id = <QCOM_ID_SM8850 0x20000>; /* SM8850 v2.0 */
	qcom,board-id = <0 0>;

	aliases {
		serial0 = &uart7;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:115200n8";

		framebuffer: framebuffer@b8000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfc800000 0x0 0x2b00000>;
			width = <1272>;
			height = <2772>;
			stride = <(1272 * 4)>;
			format = "a8r8g8b8";
		};
	};

	reserved-memory {

		bootloader_log_mem: botloader_mem@81ce4000 {
			reg = <0 0x81ce4000 0 0x10000>;
		};

		dump_device_info_mem: device_info_mem@a7f00000 {
			reg = <0 0xa7f00000 0 0x8000>;
			no-map;
		};

		/*
		 * The bootloader will only keep display hardware enabled
		 * if this memory region is named exactly 'splash_region'
		 */

		splash_memory: splash_region@fc800000 {
			reg = <0x0 0xfc800000 0x0 0x2b00000>;
			no-map;
		};

		/*
		 * The rmtfs memory region in downstream is 'dynamically allocated'
		 * but given the same address every time. Hard code it as this address is
		 * where the modem firmware expects it to be.
		 */
		rmtfs_mem: memory@d0d00000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x0 0xd0d00000 0x0 0x400000>;
			no-map;

			qcom,client-id = <1>;
			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
		};

	};

	/*
	 * Display bring-up: COLD-PROBE (mirrors the working Nubia Z80 Ultra kaanapali
	 * reference, same SoC). NO simple-framebuffer node and NO
	 * qcom,skip-mdss-reset: the UEFI continuous-splash handoff was the cause of
	 * the rainbow-bands / green-line freeze (simplefb clk_prepare_enable, or
	 * msm_mdss_enable() on the live UEFI-scanout MDP -> AXI/NoC stall). Cold-
	 * probe: msm_mdss_reset() idles the MDP first, the panel driver brings the
	 * display up later at the DRM modeset. Console is on serial0 (UART), not the
	 * framebuffer. The MDSS/dispcc/dsi0/dsi0_phy/mmss_noc nodes are enabled
	 * below; GPU/GMU/zap enabled for Adreno bring-up (stock PAS; SEA fixed
	 * in Mu-Silicium EFI memory map Reserv carveouts, not kernel tzmem).
	 */

	clocks {
		xo_board: xo-board {
			compatible = "fixed-clock";
			clock-frequency = <76800000>;
			#clock-cells = <0>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};

		bi_tcxo_div2: bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-mult = <1>;
			clock-div = <2>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
			clock-mult = <1>;
			clock-div = <2>;
		};
	};

	/*
	 * Touch AVDD is GPIO-switched on PMH0110_D GPIO9 (not L14B).
	 * Model as regulator-fixed for mainline avdd-supply consumers.
	 */
	touch_avdd_2v8: touch-avdd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "touch_avdd_2v8";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&pmh0110_d_e0_gpios 9 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	gpio-keys {
		compatible = "gpio-keys";

		/*
		 * Infiniti (canoe-mtp / 24831): volume-down is wired to
		 * PMH0101 GPIO 6, not TLMM 101 (that is kaanapali-mtp/QRD).
		 * Volume-up stays on pmk8850 pon_resin.
		 */
		pinctrl-0 = <&key_vol_down_default>;
		pinctrl-names = "default";

		key-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pmh0101_gpios 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <32>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic-glink {
		compatible = "qcom,kaanapali-pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_ss_in: endpoint {
						remote-endpoint = <&usb_dp_qmpphy_out>;
					};
				};

				port@2 {
					reg = <2>;

					// pmic_glink_sbu: endpoint {
					// 	remote-endpoint = <&fsa4480_sbu_mux>;
					// };
				};

			};
		};
	};

};

&pmih0108_e1_eusb2_repeater {
	qcom,tune-usb2-preem = /bits/ 8 <0x4>;
	qcom,tune-usb2-slew = /bits/ 8 <0x2>;
	qcom,tune-usb2-disc-thres = /bits/ 8 <0x7>;
	qcom,tune-usb2-amplitude = /bits/ 8 <0xe>;
	qcom,squelch-detector-bp = <(-2000)>;
	vdd18-supply = <&vreg_l15b_1p8>;
	vdd3-supply = <&vreg_l5b_3p1>;

	status = "okay";
};

/*
 * SPMI1 PMICs not present on the Infiniti variant. The downstream canoe DT
 * (a multi-SKU superset) declares pmd8028 @ SID 0x4 and pm8010_n @ SID 0xd, but
 * on this device the SPMI arbiter NACKs both USIDs (status 0x3) and the RPMh
 * Command DB has no L*N_E1 entries, i.e. the silicon is absent. Disable the
 * nodes so the generic pmic-spmi driver does not try to probe them (avoids the
 * "transaction failed" WARN + -EIO probe failures). pm8010_m @ SID 0xc IS
 * present and stays enabled.
 */
&pm8010_n_e1 {
	status = "disabled";
};

&pmd8028_e1 {
	status = "disabled";
};

&apps_rsc {
	regulators-0 {
		compatible = "qcom,pmh0101-rpmh-regulators";
		qcom,pmic-id = "B_E0";

		vreg_bob1: bob1 {
			regulator-name = "vreg_bob1";
			regulator-min-microvolt = <3008000>;
			regulator-max-microvolt = <4000000>;
