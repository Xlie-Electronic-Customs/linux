/dts-v1/;

#include <dt-bindings/arm/qcom,ids.h>
#include <dt-bindings/clock/qcom,sm8550-camcc.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include "sm8550.dtsi"
#include "pm8010.dtsi"
#include "pm8550.dtsi"
#include "pm8550b.dtsi"
#define PMK8550VE_SID 5
#include "pm8550ve.dtsi"
#include "pm8550vs.dtsi"
#include "pmk8550.dtsi"
#include "pmr735d_a.dtsi"
#include "pmr735d_b.dtsi"

/delete-node/ &adspslpi_mem;

/ {
	model = "Poco F6 Pro";
	compatible = "xiaomi,vermeer", "qcom,sm8550";
	chassis-type = "handset";

	/* required for bootloader to select correct board */
	qcom,msm-id = <QCOM_ID_SM8550 0x20000>; /* SM8550 v2.0 */
	qcom,board-id = <0x10008 0>;

	aliases {
		serial0 = &uart7;
		serial1 = &uart14;
	};

	/*
	 * gpio126 gates the input of the camera LDO PMIC (FAN53870).  The vendor
	 * devicetree calls it "wl2868c_enable" and expresses it as two pinctrl
	 * states on the PMIC node, which the mainline pinctrl core would never
	 * apply.  Model it as a fixed regulator instead: it is always on, and
	 * because it is a regulator the core can order it before the LDOs that
	 * depend on it (see vin-supply below).
	 */
	wl2868c_enable: regulator-wl2868c-enable {
		compatible = "regulator-fixed";
		regulator-name = "wl2868c_enable";

		gpio = <&tlmm 126 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;

		pinctrl-names = "default";
		pinctrl-0 = <&wl2868c_enable_default>;
	};

	/*
	 * Macro camera VIO rail: the vendor gates it with gpio66 through a
	 * pinctrl state ("macro_iovdd_active/suspend"), which the mainline
	 * pinctrl core never applies.  Model it as a fixed regulator instead.
	 */
	camera_macro_iovdd_ldo: regulator-camera-macro-iovdd {
		compatible = "regulator-fixed";
		regulator-name = "camera_macro_iovdd_ldo";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-enable-ramp-delay = <100>;

		gpio = <&tlmm 66 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-names = "default";
		pinctrl-0 = <&cam_macro_iovdd_default>;
	};

	wcd938x: audio-codec {
		compatible = "qcom,wcd9385-codec";

		pinctrl-names = "default";
		pinctrl-0 = <&wcd_default>;

		qcom,micbias1-microvolt = <1800000>;
		qcom,micbias2-microvolt = <1800000>;
		qcom,micbias3-microvolt = <1800000>;
		qcom,micbias4-microvolt = <1800000>;
		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
		qcom,rx-device = <&wcd_rx>;
		qcom,tx-device = <&wcd_tx>;

		reset-gpios = <&tlmm 108 GPIO_ACTIVE_LOW>;

		vdd-buck-supply = <&vreg_l15b_1p8>;
		vdd-rxtx-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l15b_1p8>;
		vdd-mic-bias-supply = <&vreg_bob1>;

		#sound-dai-cells = <1>;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bootargs = "earlycon clk_ignore_unused pd_ignore_unused";
		stdout-path = "serial0:115200n8";

		framebuffer: framebuffer@b8000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xb8000000 0x0 0x2b00000>;
			width = <1440>;
			height = <3200>;
			stride = <(1440 * 4)>;
			format = "a8r8g8b8";
		};

	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&volume_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <32>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic-glink {
		compatible = "qcom,sm8550-pmic-glink", "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;
		orientation-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_1_dwc3_hs>;
					};
				};

				port@2 {
					reg = <2>;

					pmic_glink_sbu: endpoint {
						remote-endpoint = <&fsa4480_sbu_mux>;
					};
				};
			};
		};
	};

	sound {
		compatible = "qcom,sm8550-sndcard", "qcom,sm8450-sndcard";
		model = "SM8550-MTP";

		/*
		 * Secondary MI2S / TDM pins (TLMM gpio121-124).  This *must* live
		 * on a node that actually gets a struct device, because
		 * pinctrl_bind_pins() is only called from really_probe() for the
		 * device being probed (drivers/base/dd.c + drivers/base/pinctrl.c).
		 *
		 * These pins were previously put on the `dai@18` child of
		 * &q6apmbedai.  That node has no compatible and is only read by
		 * q6apm-lpass-dais via of_q6apm_parse_dai_data(), so it is never
		 * instantiated as a device and its pinctrl-0 is dead DT - the
		 * pads stayed at the TLMM reset state (GPIO/input).  With no
		 * SCK/WS/DATA reaching the amplifiers, the AW88261 SYSST check
		 * (aw88261_dev_check_sysst(), BCK must be present and stable)
		 * can never pass, the PA is never powered on and the speaker is
		 * silent even though the DSP graph runs happily.
		 *
		 * The card node is the standard mainline home for these pins
		 * (see arch/arm64/boot/dts/qcom/sm8450-oneplus-negroni.dts, which
		 * does exactly this for its TERTIARY_TDM_RX_0 speaker link), and
		 * it mirrors the vendor DT, which hangs qcom,sec-mi2s-gpios off
		 * its sound node too.
		 */
		pinctrl-names = "default";
		pinctrl-0 = <&sec_mi2s_default>;

		/*
		 * vermeer has no WSA8845 SoundWire speakers: its two speakers
		 * are Awinic AW88261 smart amps on i2c8 driven over TDM/I2S
		 * (see the vendor audio routing).  Listing the WSA widgets here
		 * made snd_soc_dapm_add_routes() fail with -ENOENT and the card
		 * never instantiated.
		 */
		audio-routing = "IN1_HPHL", "HPHL_OUT",
				"IN2_HPHR", "HPHR_OUT",
				"AMIC1", "MIC BIAS1",
				"AMIC2", "MIC BIAS2",
				"AMIC3", "MIC BIAS3",
				"AMIC4", "MIC BIAS3",
				"AMIC5", "MIC BIAS4",
				"VA DMIC0", "MIC BIAS1",
				"VA DMIC1", "MIC BIAS1",
				"VA DMIC2", "MIC BIAS3",
				"TX DMIC0", "MIC BIAS1",
				"TX DMIC1", "MIC BIAS2",
				"TX DMIC2", "MIC BIAS3",
				"TX SWR_INPUT0", "ADC1_OUTPUT",
				"TX SWR_INPUT1", "ADC2_OUTPUT",
				"TX SWR_INPUT0", "ADC3_OUTPUT",
				"TX SWR_INPUT1", "ADC4_OUTPUT";

		wcd-playback-dai-link {
			link-name = "WCD Playback";

			cpu {
				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
			};

			codec {
				sound-dai = <&wcd938x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			cpu {
				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
			};

			codec {
				sound-dai = <&wcd938x 1>, <&swr2 0>, <&lpass_txmacro 0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		/*
		 * Speaker playback path: the two AW88261 amplifiers hang off the
		 * LPASS secondary time-division bus.  The vendor drives them in
		 * *TDM* mode, not plain I2S - see
		 *
		 *   - vendor DTS (kalama snd card):
		 *       qcom,sec-mi2s-gpios = <&cdc_sec_tdm_gpios>;
		 *       qcom,tdm-audio-intf  = <1>;
		 *       qcom,tdm-max-slots   = <4>;
		 *     where cdc_sec_tdm_gpios pinctrl-0 is the tdm1 group
		 *     (tdm1_clk/ws/din/dout) and tdm1_dout is TLMM gpio124 muxed
		 *     to function "i2s1_data1" (the pad name; the interface mode is
		 *     still TDM);
		 *   - vendor audio HAL routing (downloadable resourcemanager):
		 *       PAL_DEVICE_OUT_SPEAKER -> back_end_name
		 *                                "TDM-LPAIF-RX-SECONDARY"
		 *       bit_width 32, PAL_AUDIO_FMT_PCM_S32_LE, 48 kHz, 2 ch.
		 *
		 * So the faithful mainline BE is SECONDARY_TDM_RX_0 (DAI id 40,
		 * stream name "Secondary TDM0 Playback"), not SECONDARY_MI2S_RX.
		 * The mainline kernel does support this: q6apm-lpass-dais has
		 * q6tdm_ops/ q6tdm_set_tdm_slot, audioreach has the Audio-IF sink
		 * module (MODULE_ID_AUDIO_IF_SINK), and sc8280xp programs the TDM
		 * slots from the standard dai-tdm-slot-* properties.
		 *
		 * The *TDM* flavour is wired here as the primary path (see
		 * `sec-tdm-dai-link` below), because:
		 *
		 *   - the amplifiers' own ACF blob ships the vendor TDM
		 *     register defaults (I2SCTRL2 SLOT_NUM = TDM4S, I2SCTRL1 =
		 *     48 kHz / 64FS / 32-bit / Philips - dump with
		 *     the vendor ACF blob), and the one register block
		 *     the driver never rewrites (PLLCTRL2/PLLCTRL3) is the
		 *     ACF's; and
		 *   - TDM 4 slots x 32-bit is the only mainline BE whose LPAIF
		 *     IBIT clock is 6.144 MHz (= 4 * 32 * 48000) instead of the
		 *     1.536 MHz that the plain I2S/S16 path produces, and that
		 *     is exactly the vendor's clock plan.
		 *
		 * The MI2S flavour is kept below as a "disabled" fallback for
		 * A/B testing; `dai@18` in &q6apmbedai is its (now unused)
		 * clock description.  To go back to it, swap the two "status"
		 * values and install the matching MI2S topology
		 * as qcom/sm8550/SM8550-MTP-tplg.bin.
		 *
		 * If either AW88261 fails to probe (bad chip ID, no DVDD, reset
		 * line asserted) its component never appears and the *whole* card
		 * fails with -EPROBE_DEFER, which would take the working headset
		 * path down with it.  Both devices respond on the board:
		 *
		 *   i2cdetect -y 8        # 0x34 and 0x35 present
		 *   dmesg | grep aw88261  # "chip id = 2113" for both
		 *
		 * Enable the link only in the same boot as installing the
		 * matching topology; the generic qcom/sm8550/SM8550-MTP-tplg.bin
		 * has no secondary sub-graph at all and DPCM then fails with
		 * "no backend DAIs enabled".
		 */
		sec-mi2s-dai-link {
			link-name = "SECONDARY MI2S Playback";
			/*
			 * Fallback only: the vendor drives the speakers over
			 * secondary *TDM* (see `sec-tdm-dai-link`), which is
			 * what is enabled by default now.  Kept wired so that
			 * flipping the two "status" values plus reinstalling
			 * the MI2S topology is a one-boot A/B test.
			 */
			status = "okay";

			cpu {
				sound-dai = <&q6apmbedai SECONDARY_MI2S_RX>;
			};

			codec {
				sound-dai = <&aw88261_l>, <&aw88261_r>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		/*
		 * Vendor-accurate TDM flavour of the same link
		 * (TDM-LPAIF-RX-SECONDARY: 4 slots x 32 bit, 48 kHz).
		 *
		 * This is the default speaker backend.  The slot layout is the
		 * only knob the mainline machine driver reads here: with
		 * dai-tdm-slot-num = <4> and dai-tdm-slot-width = <32>,
		 * sc8280xp_tdm_hw_params() computes
		 *
		 *   bclk = 48000 * 4 * 32 = 6144000 Hz
		 *
		 * and votes it as the LPASS_CLK_ID_SEC_TDM_IBIT rate (see the
		 * dai@40 node in &q6apmbedai), which is the vendor's clock plan
		 * and the measurable pass/fail criterion for this change.
		 *
		 * The PCM sample format stays S16_LE (the BE hw_params fixup
		 * pins it; the BE hw_params fixup): the TDM bclk does
		 * not depend on it - it comes from the slot width above - and
		 * feeding S16 into 32-bit TDM slots is exactly what Qualcomm's
		 * own shikra TDM topology does.
		 *
		 * Requires the matching device sub-graph; install
		 * the matching TDM topology as
		 * qcom/sm8550/SM8550-MTP-tplg.bin in the same boot.
		 */
		sec-tdm-dai-link {
			link-name = "Secondary TDM0 Playback";
			status = "disabled";

			cpu {
				sound-dai = <&q6apmbedai SECONDARY_TDM_RX_0>;
				/* 4 slots, 16 bit, L+R in slots 0/1.
				 * 4 x 16 = 64 bits per frame = the "64FS" the
				 * amplifier ACF itself declares (dump-acf.py:
				 * I2SCTRL1 = 48kHz/64FS/32bit), i.e. bclk
				 * 48000 * 4 * 16 = 3072000 Hz.  The previous
				 * 4 x 32 (= 6.144 MHz) made the ADSP reject the
				 * media format with -EINVAL.
				 */
				dai-tdm-slot-num = <4>;
				dai-tdm-slot-width = <16>;
				dai-tdm-slot-rx-mask = <0x3>;
			};

			codec {
				sound-dai = <&aw88261_l>, <&aw88261_r>;
				dai-tdm-slot-num = <4>;
				dai-tdm-slot-width = <16>;
				dai-tdm-slot-rx-mask = <0x3>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		va-dai-link {
			link-name = "VA Capture";

			cpu {
				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
			};

			codec {
				sound-dai = <&lpass_vamacro 0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;

		regulator-always-on;
		regulator-boot-on;
	};

	wcn7850-pmu {
		compatible = "qcom,wcn7850-pmu";

		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en>, <&bt_default>, <&pmk8550_sleep_clk>;

		wlan-enable-gpios = <&tlmm 80 GPIO_ACTIVE_HIGH>;
		bt-enable-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;

		/* The RF reference clock.  The pwrseq driver's clock unit is a
		 * dependency of both the bluetooth and wlan targets, so this is
		 * enabled on power-on.  Matches the OnePlus 15 (kaanapali) and
		 * the sm8650/sm8750 boards; qrd omits it only because it relies
		 * on the bootloader/AOP having left it running. */
		clocks = <&rpmhcc RPMH_RF_CLK1>;

		vdd-supply = <&vreg_s5g_0p8>;
		vddio-supply = <&vreg_l15b_1p8>;
		vddaon-supply = <&vreg_s2g_0p8>;
		vdddig-supply = <&vreg_s4e_0p9>;
		vddrfa1p2-supply = <&vreg_s4g_1p3>;
		vddrfa1p8-supply = <&vreg_s6g_1p8>;

		regulators {
			vreg_pmu_rfa_cmn: ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
			};

			vreg_pmu_aon_0p59: ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
			};

			vreg_pmu_wlcx_0p8: ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
			};

			vreg_pmu_wlmx_0p85: ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
			};

			vreg_pmu_btcmx_0p85: ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
			};

			vreg_pmu_rfa_0p8: ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
			};

			vreg_pmu_rfa_1p2: ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
			};

			vreg_pmu_rfa_1p8: ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
			};

			vreg_pmu_pcie_0p9: ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
			};

			vreg_pmu_pcie_1p8: ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
			};
		};
	};

	reserved-memory {

		/*
		 * CMA pool.  The kernel default (CONFIG_CMA_SIZE_MBYTES=32) is far
		 * too small for a camera: one IMX355 frame is 3280x2464x2 = 16 MiB
		 * raw (plus a 32 MiB ABGR8888 output), and libcamera's software ISP
		 * needs several of each.  With 32 MiB the very first dma-heap
		 * allocation fails ("req-size: 8008 pages, ret: -16").
		 *
		 * Naming it linux,cma matters: libcamera's DmaBufAllocator looks for
		 * /dev/dma_heap/linux,cma first, and only then falls back to
		 * /dev/dma_heap/reserved (which is the small default pool).
		 *
		 * linux,cma-default makes this replace the built-in default region.
		 * Sized 256 MiB: 4x 16 MiB raw + 4x 32 MiB processed = 192 MiB.
		 */
		linux,cma {
			compatible = "shared-dma-pool";
			size = <0x0 0x10000000>;
			reusable;
			linux,cma-default;
		};

		xbl_dt_log_mem: xbl_dt_log@81a00000 {
			reg = <0x0 0x81a00000 0x0 0x40000>;
			no-map;
		};

		aop_image_mem: aop_image_region@81c00000 {
			reg = <0x0 0x81c00000 0x0 0x60000>;
			no-map;
		};

		xbl_ramdump_mem: xbl_ramdump_region@81200000 {
			reg = <0x0 0x81200000 0x0 0x280000>;
			no-map;
		};

		adspslpi_mem: adspslpi_region@9ea00000 {
			reg = <0x0 0x9ea00000 0x0 0x4680000>;
			no-map;
		};

		/*
		 * The bootloader will only keep display hardware enabled
		 * if this memory region is named exactly 'splash_region'
		 */

		splash_memory: splash_region@b8000000 {
			reg = <0x0 0xb8000000 0x0 0x2b00000>;
			no-map;
		};

	};
};

&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8550-rpmh-regulators";
		qcom,pmic-id = "b";

		// vdd-bob1-supply = <&vph_pwr>;
		// vdd-bob2-supply = <&vph_pwr>;
		// vdd-l1-l4-l10-supply = <&vreg_s6g_1p8>;
		// vdd-l2-l13-l14-supply = <&vreg_bob1>;
		// vdd-l3-supply = <&vreg_s4g_1p3>;
		// vdd-l5-l16-supply = <&vreg_bob1>;
		// vdd-l6-l7-supply = <&vreg_bob1>;
		// vdd-l8-supply = <&vreg_bob1>;
		// vdd-l11-supply = <&vreg_s4g_1p3>;
		// vdd-l12-supply = <&vreg_s6g_1p8>;
		// vdd-l15-supply = <&vreg_s6g_1p8>;
		// vdd-l17-supply = <&vreg_bob2>;

		vreg_bob1: bob1 {
			regulator-name = "vreg_bob1";
			regulator-min-microvolt = <3296000>;
			regulator-max-microvolt = <3960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_bob2: bob2 {
			regulator-name = "vreg_bob2";
			regulator-min-microvolt = <2720000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1b_1p8: ldo1 {
			regulator-name = "vreg_l1b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2b_3p0: ldo2 {
			regulator-name = "vreg_l2b_3p0";
			regulator-min-microvolt = <3200000>;
			regulator-max-microvolt = <3200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l4b_1p8: ldo4 {
			regulator-name = "vreg_l4b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l5b_3p1: ldo5 {
			regulator-name = "vreg_l5b_3p1";
			regulator-min-microvolt = <3104000>;
			regulator-max-microvolt = <3104000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l6b_1p8: ldo6 {
			regulator-name = "vreg_l6b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l7b_1p8: ldo7 {
			regulator-name = "vreg_l7b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3008000>;
